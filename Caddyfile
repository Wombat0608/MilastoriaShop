# TLS + reverse proxy. Caddy сам получает и продлевает Let's Encrypt.
# DNS: A milastoria.com → IP VPS (Reg.ru → DNS-записи).

{
	email shop@milastoria.com
}

milastoria.com {
	encode zstd gzip
	reverse_proxy app:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

www.milastoria.com {
	redir https://milastoria.com{uri} permanent
}
