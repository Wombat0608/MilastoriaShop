<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ru.milastoria.mapper.MediaGroupMapper">

    <select id="findById" resultType="ru.milastoria.domain.MediaGroup">
        SELECT id, name, created_at
        FROM media_groups
        WHERE id = #{id}
    </select>

    <insert id="insertTemporary" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO media_groups (name, created_at)
        VALUES (#{tempName}, #{createdAt})
    </insert>

    <update id="updateName">
        UPDATE media_groups SET name = #{name} WHERE id = #{id}
    </update>
</mapper>
